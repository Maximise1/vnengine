block start { // Always beginning execution from "start" block
    testString = "My_string"
    testNumber = 1234
    testBoolean = true
    test = 10
    mc "..."
    "Narrator speech."

    _test_underscore = 42

    if (_test_underscore == 42) {
        "Underscores work!!!"
    }

    BiG_LeTtErS = 42
    if (BiG_LeTtErS == 42) {
        "Big letters work!!!"
    }

    a1 = 42
    if (a1 == 42) {
        "Numbers work!!!"
    }

    // Common backgrounds
    background 3 { // Static, centered
        advance = after_click
    }
    background 3 { // Static, positioned top
        advance = after_click
        position = top
    }
    background 3 {
        advance = after_click
        position = right
    }
    background 3 {
        advance = after_click
        position = left
    }
    background 3 { // order of arguments doesn't matter
        position = bottom
        advance = after_click
    }

    // Panning animations
    background 2 {
        advance = after_click
        position = bottom_to_top
        time = 2.0
    }
    background 2 {
        advance = after_click
        position = top_to_bottom
        time = 3.5
    }
    background 2 {
        advance = after_click
        position = left_to_right
        time = 1.5
    }
    background 2 {
        advance = after_click
        position = right_to_left
        time = 2.0
    }

    // Custom positioning
    background 3 {
        advance = after_click
        position = custom_static
        x = 10%
        y = 10%
    }
    background 2 {
        advance = after_click
        position = custom_animation
        startx = 0%
        endx = 100%
        starty = 0%
        endy = 100%
        time = 2.0
    }

    mc ""Very long string. Newlines are replaced with spaces.
    Continuation of a very long string.""
    background 2
    execute continuation
    mc "..."
    mc "..."
}

block continuation {
    "This is some text."

    choice {
        "Option 1" ((test == 10) and (test != 100)) {
            "Option 1 called"
        }
        "Option 2" {
            "Option 2 called"
            "More text1"
            if test == 10 {
                "Text inside if"
                "Text inside if1"
                "Text inside if2"
                "Text inside if3"
            }
            "More text2"
            "More text3"
        }
        "Option 3" test == 120 {
            "Option 3 called"
        }
    }

    "More text"
    "More text10"
    "More text11"
    "More text12"
    "More text13"

    if test == 10 {
        "Test = 10"
    } else {
        "Test != 10"
    }
}